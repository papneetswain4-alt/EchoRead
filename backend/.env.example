# EchoRead Backend Environment Variables
PORT=8000
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Path to Python executable.
# Leave empty for automatic detection (checks venv/Scripts/python.exe, venv/bin/python, python3, python)
PYTHON_EXECUTABLE=

# Timeout in milliseconds for Python TTS child processes
PYTHON_SCRIPT_TIMEOUT_MS=60000

# Concurrency limit for simultaneous TTS speech synthesis subprocesses
MAX_CONCURRENT_TTS_JOBS=5
