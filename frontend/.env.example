# EchoRead Frontend Environment Variables
#
# Local Development:
# Leave empty to route requests through Vite's local dev proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=

# Production (Vercel):
# Set to your deployed Render backend service URL.
# Example: https://echoread-backend.onrender.com
# (The frontend automatically normalizes the URL and targets the /api prefix)
